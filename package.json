{
  "name": "afr-lightning-bootcamp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"WEB,API\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:backend\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:backend": "cd apps/backend && npm run start:dev",
    "build": "npm run build --workspaces",
    "build:web": "cd apps/web && npm run build",
    "build:backend": "cd apps/backend && npm run build",
    "db:generate": "cd apps/backend && npm run prisma:generate",
    "db:seed": "cd apps/backend && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
